generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String
  platform  String   @default("unknown")
  views     Int      @default(0)
  createdAt DateTime @default(now())
}model Ad {
  id        String   @id @default(cuid())
  name      String
  code      String
  placement String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model AdPattern {
  id      String  @id @default(cuid())
  pattern String  @unique
  enabled Boolean @default(false)
  config  String
}

model Platform {
  id            String  @id @default(cuid())
  name          String
  pattern       String
  embedType     String
  embedTemplate String?
  needsProxy    Boolean @default(false)
  enabled       Boolean @default(true)
  order         Int     @default(0)
}

model DailyLimit {
  ip      String   @id
  count   Int      @default(0)
  resetAt DateTime
}
model SiteSettings {
  id              Int      @id @default(1)
  siteName        String   @default("BrineTube")
  tagline         String   @default("Stream & Download Media Directly")
  primaryColor    String   @default("#3b82f6")
  backgroundColor String   @default("#0f172a")
  logoUrl         String?
  fontFamily      String   @default("Inter")
  borderRadius    String   @default("0.5rem")
  maintenanceMode Boolean  @default(false)
  downloadEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model PlatformConfig {
  id         String   @id @default(uuid())
  platform   String   @unique
  isActive   Boolean  @default(true)
  proxyPool  String   @default("[]")
  cookies    String?
  rateLimit  Int      @default(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ExtractionCache {
  id          String   @id @default(uuid())
  originalUrl String   @unique
  platform    String
  title       String
  thumbnails  String   @default("[]")
  formats     String   @default("[]")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}
model ExtractionProvider {
  id           String   @id @default(uuid())
  name         String
  type         String
  priority     Int      @default(0)
  enabled      Boolean  @default(true)
  platforms    String   @default("[]")
  config       String   @default("{}")
  lastStatus   String?
  lastError    String?
  lastTestAt   DateTime?
  successCount Int      @default(0)
  failCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Cookie {
  id         String   @id @default(uuid())
  platform   String   @unique
  cookies    String
  expiresAt  DateTime
  pastedAt   DateTime @default(now())
  lastUsedAt DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
